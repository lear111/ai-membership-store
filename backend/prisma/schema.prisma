generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum ProductType {
  SUBSCRIPTION
  ONE_TIME
}

// DAY is a fixed number of days; MONTH/YEAR are calendar periods.
enum ServicePeriodUnit {
  DAY
  MONTH
  YEAR
}

enum TargetField {
  EMAIL
  TEXT
  NONE
}

enum OrderKind {
  INITIAL
  RENEWAL
  ONE_TIME
}

enum OrderSource {
  USER
  ADMIN
  SYSTEM_RENEWAL
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REFUND_PENDING
  REFUNDED
  NOT_REQUIRED
}

enum FulfillmentStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionKind {
  PAYMENT
  REFUND
}

enum PaymentChannel {
  WECHAT
  ALIPAY
  CASH
  BANK_TRANSFER
  OTHER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum SubscriptionSource {
  ADMIN
  SYSTEM
  ORDER
}

enum OrderActorType {
  USER
  ADMIN
  SYSTEM
}

enum ActorType {
  ADMIN
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  TERMINATED
}

enum OrderEventType {
  ORDER_CREATED
  PAYMENT_RECORDED
  PAYMENT_CONFIRMED
  REFUND_RECORDED
  REFUND_CONFIRMED
  FULFILLMENT_CHANGED
  COMPLETED
  NOTE
  CANCELLED
}

enum SubscriptionEventType {
  CREATED
  ACTIVATED
  RENEWED
  EXPIRY_ADJUSTED
  MANUAL_GRANT
  HISTORICAL_IMPORT
  SUSPENDED
  RESUMED
  TERMINATED
  NOTE
  UPDATED
  PRICE_CHANGED
  FORM_DATA_UPDATED
  AUTO_TERMINATED
}

model SupportSettings {
  id Int @id
  agentId String? @db.VarChar(36)
  emailEnabled Boolean @default(false)
  agent User? @relation(fields: [agentId], references: [id], onDelete: Restrict)
}

model SupportThread {
  customerId String @id @db.VarChar(36)
  agentId String? @db.VarChar(36)
  pendingAt DateTime?
  customerRead Int @default(0)
  agentRead Int @default(0)
  updatedAt DateTime @updatedAt
  customer User @relation("ChatCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  agent User? @relation("ChatAgent", fields: [agentId], references: [id], onDelete: Restrict)
  messages SupportMessage[]
  @@index([agentId, updatedAt])
}

model SupportMessage {
  id Int @id @default(autoincrement())
  customerId String @db.VarChar(36)
  senderId String @db.VarChar(36)
  fromAgent Boolean
  requestId String @db.VarChar(36)
  text String @db.Text
  audio Bytes? @db.MediumBlob
  audioType String? @db.VarChar(24)
  orderId String? @db.VarChar(36)
  createdAt DateTime @default(now())
  thread SupportThread @relation(fields: [customerId], references: [customerId], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([senderId, requestId])
  @@index([customerId, id])
}

model SupportReminder {
  id Int @id @default(autoincrement())
  customerId String @db.VarChar(36)
  agentId String @db.VarChar(36)
  nextAttempt DateTime @default(now())
  attempts Int @default(0)
  deliveredAt DateTime?
  @@index([deliveredAt, nextAttempt])
}

model User {
  supportSettings SupportSettings[]
  supportCustomers SupportThread[] @relation("ChatCustomer")
  supportAssignments SupportThread[] @relation("ChatAgent")
  id                String        @id @default(uuid()) @db.VarChar(36)
  username          String?       @db.VarChar(80)
  adminLabel        String?       @db.VarChar(80)
  loginEmail        String?       @unique @db.VarChar(254)
  notificationEmail String?       @db.VarChar(254)
  passwordHash      String?       @db.VarChar(255)
  role              UserRole      @default(CUSTOMER)
  status            AccountStatus @default(PENDING_ACTIVATION)
  activatedAt       DateTime?     @db.DateTime(3)
  createdByAdminId  String?       @db.VarChar(36)
  createdAt         DateTime      @default(now()) @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @db.DateTime(3)

  createdByAdmin        User?                @relation("UserCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdUsers          User[]               @relation("UserCreator")
  sessions              Session[]
  invitations           InvitationToken[]    @relation("InvitedUser")
  issuedInvitations     InvitationToken[]    @relation("InvitationCreator")
  orders                Order[]              @relation("OrderCustomer")
  createdOrders         Order[]              @relation("OrderCreator")
  customerCreatedOrders Order[]              @relation("CustomerOrderCreator")
  recordedTransactions  PaymentTransaction[] @relation("TransactionCreator")
  confirmedTransactions PaymentTransaction[] @relation("TransactionConfirmer")
  subscriptions         Subscription[]       @relation("SubscriptionCustomer")
  createdSubscriptions  Subscription[]       @relation("SubscriptionCreator")
  orderEvents           OrderEvent[]         @relation("OrderAdminActor")
  customerOrderEvents   OrderEvent[]         @relation("OrderUserActor")
  subscriptionEvents    SubscriptionEvent[]
  auditLogs             AdminAuditLog[]
  idempotencyRecords    IdempotencyRecord[]
  orderRevisions        OrderRevision[]
}

model Session {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @db.VarChar(36)
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.DateTime(3)
  lastSeenAt DateTime? @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model InvitationToken {
  id               String    @id @default(uuid()) @db.VarChar(36)
  userId           String    @db.VarChar(36)
  tokenHash        String    @unique @db.VarChar(64)
  expiresAt        DateTime  @db.DateTime(3)
  usedAt           DateTime? @db.DateTime(3)
  revokedAt        DateTime? @db.DateTime(3)
  createdByAdminId String    @db.VarChar(36)
  createdAt        DateTime  @default(now()) @db.DateTime(3)
  user             User      @relation("InvitedUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByAdmin   User      @relation("InvitationCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  slug               String             @unique @db.VarChar(100)
  name               String             @db.VarChar(120)
  description        String?            @db.Text
  type               ProductType
  priceFen           Int
  renewalPriceFen    Int?
  termLabel          String             @db.VarChar(40)
  // NULL pair means an unknown legacy period; never infer from termLabel.
  servicePeriodUnit  ServicePeriodUnit?
  servicePeriodCount Int?
  coverImageKey      String?            @db.VarChar(64)
  targetField        TargetField        @default(NONE)
  listed             Boolean            @default(false)
  sortOrder          Int                @default(0)
  formSchema         Json               @default("{\"version\":1,\"fields\":[]}")
  archivedAt         DateTime?          @db.DateTime(3)
  createdAt          DateTime           @default(now()) @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @db.DateTime(3)
  orders             Order[]
  subscriptions      Subscription[]

  @@index([archivedAt, sortOrder, createdAt])
}

model Order {
  supportMessages SupportMessage[]
  version                    Int                  @default(1)
  id                         String               @id @default(uuid()) @db.VarChar(36)
  orderNo                    String               @unique @db.VarChar(40)
  userId                     String               @db.VarChar(36)
  productId                  String               @db.VarChar(36)
  subscriptionId             String?              @db.VarChar(36)
  kind                       OrderKind
  // Nullable storage rejects implicit ENUM defaults; INSERT guard + CHECK require a source.
  // Persisted identity is immutable; every order is protected from DELETE/REPLACE.
  source                     OrderSource?
  hidden                     Boolean              @default(false)
  productNameSnapshot        String               @db.VarChar(120)
  productDescriptionSnapshot String?              @db.Text
  productTypeSnapshot        ProductType
  priceSnapshotFen           Int?
  termSnapshot               String               @db.VarChar(40)
  servicePeriodUnitSnapshot  ServicePeriodUnit?
  servicePeriodCountSnapshot Int?
  // Immutable purchase target and eligibility cycle; NULL only for non-system/legacy orders.
  renewalPeriodStartAt       DateTime?            @db.DateTime(3)
  renewalPeriodEndAt         DateTime?            @db.DateTime(3)
  renewalForPeriodStartAt    DateTime?            @db.DateTime(3)
  billingAnchorSnapshotAt    DateTime?            @db.DateTime(3)
  billingTimezoneSnapshot    String?              @db.VarChar(64)
  billingRevisionSnapshot    Int?
  renewalRequestKeyHash      String?              @unique(map: "Order_renewal_request_key_hash_key") @db.VarChar(64)
  renewalRequestHash         String?              @db.VarChar(64)
  // Historical values are unknown, not the product's current form/period.
  formSchemaSnapshot         Json?
  formData                   Json?
  amountFen                  Int
  renewalPriceSnapshotFen    Int?
  contactEmailSnapshot       String?              @db.VarChar(254)
  targetIdentifier           String?              @db.VarChar(254)
  paymentStatus              PaymentStatus        @default(UNPAID)
  fulfillmentStatus          FulfillmentStatus    @default(NOT_STARTED)
  // Actual full-payment occurrence; frozen copy of the confirmed PAYMENT's occurredAt.
  paidAt                     DateTime?            @db.DateTime(3)
  // Deprecated legacy entry timestamp. Preserve history; new flows never write/read it as paidAt.
  paymentRecordedAt          DateTime?            @db.DateTime(3)
  // When the administrator confirmed receipt, distinct from actual payment and row creation.
  paymentConfirmedAt         DateTime?            @db.DateTime(3)
  // Actual fulfillment completion time.
  fulfilledAt                DateTime?            @db.DateTime(3)
  cancelledAt                DateTime?            @db.DateTime(3)
  cancellationReason         String?              @db.VarChar(500)
  internalNote               String?              @db.Text
  createdByAdminId           String?              @db.VarChar(36)
  createdByUserId            String?              @db.VarChar(36)
  createdAt                  DateTime             @default(now()) @db.DateTime(3)
  updatedAt                  DateTime             @updatedAt @db.DateTime(3)
  user                       User                 @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product                    Product              @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscription               Subscription?        @relation("RenewalOrders", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByAdmin             User?                @relation("OrderCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser              User?                @relation("CustomerOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourcedSubscription        Subscription?        @relation("SubscriptionSourceOrder")
  earlyRenewedSubscription   Subscription?        @relation("EarlyRenewalOrder")
  transactions               PaymentTransaction[]
  events                     OrderEvent[]
  subscriptionEvents         SubscriptionEvent[]
  revisions                  OrderRevision[]

  // New system orders are created only on successful payment, in the fulfillment transaction.
  @@unique([subscriptionId, billingRevisionSnapshot, renewalForPeriodStartAt], map: "Order_renewal_eligibility_key")
  @@unique([subscriptionId, billingRevisionSnapshot, renewalPeriodStartAt], map: "Order_renewal_target_key")
  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([source, hidden, createdAt])
}

model PaymentTransaction {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  orderId            String            @db.VarChar(36)
  kind               TransactionKind
  channel            PaymentChannel
  amountFen          Int
  status             TransactionStatus @default(PENDING)
  externalReference  String?           @db.VarChar(120)
  // External occurrence; for the confirmed full PAYMENT this equals Order.paidAt.
  occurredAt         DateTime          @db.DateTime(3)
  confirmedAt        DateTime?         @db.DateTime(3)
  createdByAdminId   String            @db.VarChar(36)
  confirmedByAdminId String?           @db.VarChar(36)
  note               String?           @db.VarChar(500)
  // Database entry time, not the external payment occurrence.
  createdAt          DateTime          @default(now()) @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @db.DateTime(3)
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByAdmin     User              @relation("TransactionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedByAdmin   User?             @relation("TransactionConfirmer", fields: [confirmedByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, kind, status])
}

model OrderEvent {
  id            String         @id @default(uuid()) @db.VarChar(36)
  orderId       String         @db.VarChar(36)
  eventType     OrderEventType
  actorAdminId  String?        @db.VarChar(36)
  actorUserId   String?        @db.VarChar(36)
  actorType     OrderActorType @default(ADMIN)
  fromStateJson Json?
  toStateJson   Json?
  note          String?        @db.VarChar(500)
  createdAt     DateTime       @default(now()) @db.DateTime(3)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin    User?          @relation("OrderAdminActor", fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser     User?          @relation("OrderUserActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId, createdAt])
}

model Subscription {
  id                         String              @id @default(uuid()) @db.VarChar(36)
  userId                     String              @db.VarChar(36)
  productId                  String              @db.VarChar(36)
  sourceOrderId              String?             @unique @db.VarChar(36)
  productNameSnapshot        String              @db.VarChar(120)
  productDescriptionSnapshot String?             @db.Text
  productTypeSnapshot        ProductType
  priceSnapshotFen           Int
  termSnapshot               String              @db.VarChar(40)
  servicePeriodUnitSnapshot  ServicePeriodUnit?
  servicePeriodCountSnapshot Int?
  // Stable through renewals; explicit manual expiry correction resets anchor and increments revision.
  billingAnchorAt            DateTime?           @db.DateTime(3)
  billingTimezone            String?             @db.VarChar(64)
  billingRevision            Int?
  currentPeriodStartAt       DateTime?           @db.DateTime(3)
  currentPeriodEndAt         DateTime?           @db.DateTime(3)
  // Successful early renewal marker for a particular current-period start.
  earlyRenewedPeriodStartAt  DateTime?           @db.DateTime(3)
  earlyRenewalOrderId        String?             @unique @db.VarChar(36)
  // Explicit false for a fresh ORDER cycle; NULL preserves unknown legacy eligibility.
  earlyRenewalUsed           Boolean?
  formSchemaSnapshot         Json                @default("{\"version\":1,\"fields\":[]}")
  formData                   Json                @default("{}")
  note                       String?             @db.VarChar(2000)
  terminatedAt               DateTime?           @db.DateTime(3)
  terminationReason          String?             @db.VarChar(500)
  version                    Int                 @default(1)
  sourceType                 SubscriptionSource
  targetIdentifier           String?             @db.VarChar(254) // Retained read-only for legacy records.
  startedAt                  DateTime            @db.DateTime(3)
  expiresAt                  DateTime            @db.DateTime(3)
  renewalPriceFen            Int
  status                     SubscriptionStatus  @default(ACTIVE)
  createdByAdminId           String?             @db.VarChar(36)
  createdAt                  DateTime            @default(now()) @db.DateTime(3)
  updatedAt                  DateTime            @updatedAt @db.DateTime(3)
  user                       User                @relation("SubscriptionCustomer", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product                    Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceOrder                Order?              @relation("SubscriptionSourceOrder", fields: [sourceOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  earlyRenewalOrder          Order?              @relation("EarlyRenewalOrder", fields: [earlyRenewalOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByAdmin             User?               @relation("SubscriptionCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  renewalOrders              Order[]             @relation("RenewalOrders")
  events                     SubscriptionEvent[]

  @@index([productId, status])
  @@index([sourceType, createdAt])
  @@index([userId, status])
  @@index([expiresAt, status])
}

model SubscriptionEvent {
  id             String                @id @default(uuid()) @db.VarChar(36)
  subscriptionId String                @db.VarChar(36)
  orderId        String?               @db.VarChar(36)
  eventType      SubscriptionEventType
  oldStartedAt   DateTime?             @db.DateTime(3)
  newStartedAt   DateTime?             @db.DateTime(3)
  oldExpiresAt   DateTime?             @db.DateTime(3)
  newExpiresAt   DateTime?             @db.DateTime(3)
  actorAdminId   String?               @db.VarChar(36)
  actorType      ActorType             @default(ADMIN)
  beforeJson     Json?
  afterJson      Json?
  reason         String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorAdmin     User?                 @relation(fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionId, createdAt])
}

model AdminAuditLog {
  id           String    @id @default(uuid()) @db.VarChar(36)
  actorAdminId String?   @db.VarChar(36)
  actorType    ActorType @default(ADMIN)
  action       String    @db.VarChar(80)
  entityType   String    @db.VarChar(40)
  entityId     String    @db.VarChar(40)
  beforeJson   Json?
  afterJson    Json?
  reason       String?   @db.VarChar(500)
  requestId    String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  actorAdmin   User?     @relation(fields: [actorAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorAdminId, createdAt])
}

model AppSettings {
  id                  Int      @id @default(1)
  storeName           String   @db.VarChar(80)
  ownerEmail          String   @db.VarChar(254)
  timezone            String   @default("Asia/Shanghai") @db.VarChar(64)
  paymentInstructions String   @default("") @db.VarChar(4000)
  wechatPayEnabled    Boolean  @default(false)
  wechatQrImageKey    String?  @db.VarChar(40)
  updatedAt           DateTime @updatedAt @db.DateTime(3)
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.VarChar(36)
  actorUserId  String   @db.VarChar(36)
  keyHash      String   @db.VarChar(64)
  requestHash  String   @db.VarChar(64)
  operation    String   @db.VarChar(160)
  responseJson Json
  createdAt    DateTime @default(now()) @db.DateTime(3)
  actorUser    User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([actorUserId, keyHash])
}

model OrderRevision {
  id                    String         @id @default(uuid()) @db.VarChar(36)
  orderId               String         @db.VarChar(36)
  version               Int
  snapshotSchemaVersion Int
  snapshotJson          Json
  actorUserId           String?        @db.VarChar(36)
  actorType             OrderActorType
  reason                String?        @db.VarChar(500)
  createdAt             DateTime       @default(now()) @db.DateTime(3)
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUser             User?          @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, version])
  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}
