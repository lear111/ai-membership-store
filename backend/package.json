{
  "name": "@membership-store/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "start:production": "node dist/server.js --production",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "db:generate": "node scripts/prisma.ts generate",
    "db:format": "node scripts/prisma.ts format",
    "db:validate": "node scripts/prisma.ts validate",
    "db:migrate": "node --env-file-if-exists=../.env scripts/prisma.ts migrate deploy",
    "db:status": "node --env-file-if-exists=../.env scripts/prisma.ts migrate status",
    "db:seed": "node --env-file-if-exists=../.env scripts/prisma.ts db seed",
    "db:migrate:production": "node scripts/prisma.ts --production migrate deploy",
    "db:status:production": "node scripts/prisma.ts --production migrate status",
    "db:bootstrap:production": "node prisma/bootstrap-admin.ts",
    "test:db": "node scripts/test-database.ts",
    "test:production": "npm run build && node scripts/test-production.ts",
    "test:e2e": "node scripts/test-database.ts --e2e"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "express": "^5.1.0",
    "nodemailer": "^10.6.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "prisma": "7.10.1"
  }
}
